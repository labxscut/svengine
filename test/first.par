[xwgsim]
#number of libraries
#haplotype option should be always set on wgsim
nlibrary=5
#library-wise option=optbam"lib1":optbam2
libnames=["lib1","lib2","lib3","lib4","lib5"]
coverage: {"lib1":2,"lib2":5,"lib3":10,"lib4":20,"lib5":50}
# for the tuple in isize, [mode_weight, mode_mean, mode_sd]
isize: {"lib1":[[1,300,30]],"lib2":[[1,300,30]],"lib3":[[1,300,30]],"lib4":[[1,300,30]],"lib5":[[1,300,30]]}
read1: {"lib1":100,"lib2":100,"lib3":100,"lib4":100,"lib5":100}
read2: {"lib1":100,"lib2":100,"lib3":100,"lib4":100,"lib5":100}
